# .git is the repository metadata. Git never stages it, so it is not listed here.

# Linux 0.11 build products (same set as Makefile clean)
*.o
*.a
Image
System.map
tmp_make
tmp.s
core
**/boot/bootsect
**/boot/setup
**/boot/bootsect.elf
**/boot/setup.elf
**/tools/system
**/tools/system.elf
**/tools/build

# RV32 kernel and user programs. labs/rv32/qemu/launch.sh builds them.
src/rv32/kernel.elf
src/user/*.elf
# RV64 kernel and user programs. labs/rv64/qemu/launch.sh builds them.
src/rv64/kernel.elf
src/rv64/user/*.elf
# cpp output of keyboard.S; the source is keyboard.S
**/kernel/chr_drv/keyboard.s

# Teaching disk used by QEMU. It stays a download and is not generated in this tree.
rootfs/hdc-0.11.img

# Generated boot images in this repository
/images/*

# Empty-directory placeholders. Git does not store empty directories.
**/.gitkeep

# gem5 run output. launch.sh writes labs/i386/gem5/m5out/.
m5out/
*.log
__pycache__/

# gem5 source and build. labs/i386/gem5/build.sh clones the pinned release here.
.gem5/
