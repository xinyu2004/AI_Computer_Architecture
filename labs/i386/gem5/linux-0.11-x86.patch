+void
+FsWorkload::onCopyPageEntry(ThreadContext *tc)
+{
+    if (linux011CountArmed)
+        return;
+    linux011CountArmed = true;
+    statistics::reset();
+    linux011TraceWindow(true);
+    // f3 a5 is the rep movsl. The next instruction is two bytes later.
+    // The exit fires when that instruction is about to run, so the
+    // window is the copy.
+    armCountedExit(tc, copyPagePc + 2, "copy_page returned");
+    inform("copy_page rep movsl at %#x, counters restarted.\n", copyPagePc);
+}
