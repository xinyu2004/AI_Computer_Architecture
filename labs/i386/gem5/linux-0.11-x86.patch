+void
+FsWorkload::onScheduleEntry(ThreadContext *tc)
+{
+    if (linux011CountArmed)
+        return;
+    linux011CountArmed = true;
+    statistics::reset();
+    linux011TraceWindow(true);
+    inform("schedule entered, counters restarted.\n");
+}
+
+void
+FsWorkload::onScheduleLjmp(ThreadContext *tc)
+{
+    if (!linux011CountArmed || countedExitPcEvent != nullptr)
+        return;
+
+    // switch_to stores the TSS selector at 4(%esp), then ljmp *(%esp).
+    // This event runs before that ljmp. The destination TSS still holds
+    // the new task's EIP.
+    const Addr esp = tc->getReg(int_reg::Rsp);
+    uint16_t sel = 0;
+    TranslatingPortProxy proxy(tc);
+    proxy.readBlob(esp + 4, &sel, sizeof(sel));
+    sel = letoh(sel);
+    fatal_if(sel & 4, "schedule ljmp through an LDT selector %#x.", sel);
+
+    const Addr gdt = tc->readMiscRegNoEffect(misc_reg::TsgBase);
+    uint8_t desc[8];
+    proxy.readBlob(gdt + (sel & ~7), desc, sizeof(desc));
+    auto descBase = [](const uint8_t *d) -> uint32_t {
+        return d[2] | (d[3] << 8) | (d[4] << 16) | (d[7] << 24);
+    };
+    const uint32_t tssBase = descBase(desc);
+    uint32_t eip = 0;
+    proxy.readBlob(tssBase + 32, &eip, sizeof(eip));
+    eip = letoh(eip);
+    fatal_if(eip == 0, "schedule TSS %#x has a zero EIP.", sel);
+
+    // PC events see the linear address. A user CS has a non-zero base.
+    uint16_t cs = 0;
+    proxy.readBlob(tssBase + 76, &cs, sizeof(cs));
+    cs = letoh(cs);
+    uint32_t segBase = 0;
+    if ((cs & ~3) != 0) {
+        Addr table = gdt;
+        if (cs & 4) {
+            uint16_t ldtSel = 0;
+            proxy.readBlob(tssBase + 96, &ldtSel, sizeof(ldtSel));
+            ldtSel = letoh(ldtSel);
+            uint8_t ldtDesc[8];
+            proxy.readBlob(gdt + (ldtSel & ~7), ldtDesc, sizeof(ldtDesc));
+            table = descBase(ldtDesc);
+        }
+        uint8_t segDesc[8];
+        proxy.readBlob(table + (cs & ~7), segDesc, sizeof(segDesc));
+        segBase = descBase(segDesc);
+    }
+    const Addr exitPc = static_cast<Addr>(eip) + segBase;
+
+    armCountedExit(tc, exitPc, "schedule switched");
+    inform("schedule ljmp selector=%#x CS=%#x linear EIP=%#x.\n",
+           sel, cs, exitPc);
+}
+
+void
+FsWorkload::onScheduleRet(ThreadContext *tc)
+{
+    if (!linux011CountArmed || countedExitPcEvent != nullptr)
+        return;
+
+    // No task switch. The event is the ret itself, before it runs.
+    // Plant the exit on the return address so the ret is included.
+    const Addr esp = tc->getReg(int_reg::Rsp);
+    uint32_t ret_eip = 0;
+    TranslatingPortProxy proxy(tc);
+    proxy.readBlob(esp, &ret_eip, sizeof(ret_eip));
+    ret_eip = letoh(ret_eip);
+    armCountedExit(tc, ret_eip, "schedule returned");
+    inform("schedule returns without a task switch, return EIP=%#x.\n",
+           ret_eip);
+}
+
+Addr
+linux011HexArg(const std::string &commandLine, const char *key)
+{
+    const std::string needle(key);
+    auto pos = commandLine.find(needle);
+    fatal_if(pos == std::string::npos,
+             "missing %s on the gem5 command line.", key);
+    std::string raw = commandLine.substr(pos + needle.size());
+    auto space = raw.find(' ');
+    if (space != std::string::npos)
+        raw.resize(space);
+    if (raw.size() > 2 && raw[0] == '0' && (raw[1] == 'x' || raw[1] == 'X'))
+        raw = raw.substr(2);
+    char *stopped = nullptr;
+    unsigned long value = std::strtoul(raw.c_str(), &stopped, 16);
+    fatal_if(raw.empty() || stopped == raw.c_str() || *stopped != '\0',
+             "bad address after %s.", key);
+    return static_cast<Addr>(value);
+}
