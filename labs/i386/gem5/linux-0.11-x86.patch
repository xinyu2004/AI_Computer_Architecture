+// O3PipeView records each microop's pipeline stages. Turn it on for
+// the measured window and leave it on. The last committed microop is
+// destroyed after the PC event, and that is when it is recorded.
+void
+linux011TraceWindow(bool on)
+{
+    if (on)
+        ::gem5::setDebugFlag("O3PipeView");
+    else
+        ::gem5::clearDebugFlag("O3PipeView");
+}
+
+// Fires when setup_paging's ret lands on the hlt planted below.
+class I386HaltExit : public PCEvent
+{
+  public:
+    I386HaltExit(PCEventScope *q, Addr pc)
+        : PCEvent(q, "setup_paging returned", pc)
+    {}
+
+    void
+    process(ThreadContext *tc) override
+    {
+        // Leave O3PipeView on so this instruction is still recorded
+        // when it is destroyed. Commit stops here.
+        o3::linux011StopCommit();
+        exitSimLoop("setup_paging returned", 0);
+    }
+};
