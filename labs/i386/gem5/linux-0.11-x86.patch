+void
+FsWorkload::initI386Protected(ThreadContext *tc)
+{
+    // Linux 0.11 head.s. Flat kernel GDT: null, code 0x08, data 0x10,
+    // 32-bit, base 0, 4KiB granularity, limit 0xfff (16MiB-1).
+    // Paging is off. setup_paging itself turns PG on, then ret.
+    // The real caller is after_page_tables, whose pushed return address
+    // is _main. This lab plants a different return address so the run
+    // stops at the end of setup_paging.
+    auto paging = kernelSymtab.find("setup_paging");
+    auto gdt = kernelSymtab.find("_gdt");
+    fatal_if(paging == kernelSymtab.end(),
+             "32-bit kernel has no setup_paging symbol.");
+    fatal_if(gdt == kernelSymtab.end(),
+             "32-bit kernel has no _gdt symbol.");
+
+    const Addr start = paging->address();
+    const Addr gdtBase = gdt->address();
+    // Above the loaded kernel (Linux 0.11 ends near 0x1c000) and outside
+    // the five pages setup_paging clears at physical 0.
+    const Addr haltAddr = 0x80000;
+    const Addr stackAddr = 0x7F000;
+
+    SegDescriptor desc = 0;
+    desc.dpl = 0;
+    desc.p = 1;
+    desc.l = 0;
+    desc.d = 1;
+    desc.s = 1;
+    desc.base = 0;
+    // Byte limit 16MiB-1. The setter turns on the granularity bit.
+    desc.limit = 0x00FFFFFF;
+
+    SegDescriptor csDesc = desc;
+    csDesc.type.codeOrData = 1;
+    csDesc.type.r = 1;
+
+    SegDescriptor dsDesc = desc;
+    dsDesc.type.codeOrData = 0;
+    dsDesc.type.w = 1;
+
+    SegSelector cs = 0;
+    cs.si = 1;
+    SegSelector ds = 0;
+    ds.si = 2;
+
+    tc->setMiscReg(misc_reg::Cs, (RegVal)cs);
+    tc->setMiscReg(misc_reg::Ds, (RegVal)ds);
+    tc->setMiscReg(misc_reg::Es, (RegVal)ds);
+    tc->setMiscReg(misc_reg::Fs, (RegVal)ds);
+    tc->setMiscReg(misc_reg::Gs, (RegVal)ds);
+    tc->setMiscReg(misc_reg::Ss, (RegVal)ds);
+
+    installSegDesc(tc, segment_idx::Cs, csDesc, false);
+    installSegDesc(tc, segment_idx::Ds, dsDesc, false);
+    installSegDesc(tc, segment_idx::Es, dsDesc, false);
+    installSegDesc(tc, segment_idx::Fs, dsDesc, false);
+    installSegDesc(tc, segment_idx::Gs, dsDesc, false);
+    installSegDesc(tc, segment_idx::Ss, dsDesc, false);
+
+    tc->setMiscReg(misc_reg::Tsl, 0);
+    SegAttr ldtAttr = 0;
+    ldtAttr.unusable = 1;
+    tc->setMiscReg(misc_reg::TslAttr, ldtAttr);
+    // The ELF already contains the kernel GDT at _gdt. Limit matches
+    // gdt_descr in head.s: 256 descriptors.
+    tc->setMiscReg(misc_reg::TsgBase, gdtBase);
+    tc->setMiscReg(misc_reg::TsgLimit, 256 * 8 - 1);
+
+    CR0 cr0 = tc->readMiscRegNoEffect(misc_reg::Cr0);
+    cr0.pg = 0;
+    tc->setMiscReg(misc_reg::Cr0, cr0);
+    cr0.pe = 1;
+    tc->setMiscReg(misc_reg::Cr0, cr0);
+
+    CR4 cr4 = tc->readMiscRegNoEffect(misc_reg::Cr4);
+    cr4.pae = 0;
+    cr4.pse = 0;
+    tc->setMiscReg(misc_reg::Cr4, cr4);
+
+    Efer efer = tc->readMiscRegNoEffect(misc_reg::Efer);
+    efer.lme = 0;
+    tc->setMiscReg(misc_reg::Efer, efer);
+
+    RegVal rflags = tc->readMiscRegNoEffect(misc_reg::Rflags);
+    rflags &= ~(1ULL << 9);
+    rflags |= 2;
+    tc->setMiscReg(misc_reg::Rflags, rflags);
+
+    if (commandLine.find("gem5_boot=startup_32") != std::string::npos) {
+        initLinux011ToTimer(tc);
+        return;
+    }
+
+    auto phys_proxy = system->physProxy;
+    uint32_t ret = htole<uint32_t>(static_cast<uint32_t>(haltAddr));
+    phys_proxy.writeBlob(stackAddr, &ret, sizeof(ret));
+    uint8_t hlt = 0xF4;
+    phys_proxy.writeBlob(haltAddr, &hlt, 1);
+    tc->setReg(int_reg::Rsp, stackAddr);
+
+    tc->pcState(start);
+
+    if (i386HaltPcEvent == nullptr)
+        i386HaltPcEvent = new I386HaltExit(tc, haltAddr);
+
+    linux011TraceWindow(true);
+    inform("32-bit protected mode, paging off, PC=%#x (_gdt at %#x). "
+           "setup_paging returns to hlt at %#x.\n",
+           start, gdtBase, haltAddr);
+}
+
+void
+FsWorkload::initLinux011ToTimer(ThreadContext *tc)
+{
+    // Head.s startup, after setup.s. The kernel loads its own GDT and
+    // IDT, builds the page tables, and reaches sti() in main. The 8259
+    // is already programmed the way setup.s left it. IRQ0 is the PIT,
+    // wired to the CPU's legacy interrupt pin.
+    auto entry = kernelSymtab.find("startup_32");
+    auto timer = kernelSymtab.find("_timer_interrupt");
+    auto stack = kernelSymtab.find("_stack_start");
+    fatal_if(entry == kernelSymtab.end(), "no startup_32 symbol.");
+    fatal_if(timer == kernelSymtab.end(), "no _timer_interrupt symbol.");
+    fatal_if(stack == kernelSymtab.end(), "no _stack_start symbol.");
+
+    auto *pic1 = dynamic_cast<I8259 *>(
+            SimObject::find("system.pc.south_bridge.pic1"));
+    auto *pic2 = dynamic_cast<I8259 *>(
+            SimObject::find("system.pc.south_bridge.pic2"));
+    fatal_if(pic1 == nullptr || pic2 == nullptr,
+             "8259 controllers are not in this system.");
+    pic1->setLegacyVectors(0x20, 0xFF, 0x04);
+    pic2->setLegacyVectors(0x28, 0xFF, 0x02);
+
+    auto *lapic = dynamic_cast<Interrupts *>(
+            tc->getCpuPtr()->getInterruptController(0));
+    fatal_if(lapic == nullptr, "local APIC is missing.");
+    // ExtInt delivery, unmasked. Bits 10:8 are the delivery mode.
+    // This is the 386 INTR pin, which Linux 0.11 expects from the 8259.
+    lapic->setReg(APIC_LVT_LINT0, delivery_mode::ExtInt << 8);
+
+    // Boot parameters setup.s stores at 0x90000. 16MiB machine:
+    // extended memory above 1MiB is 15*1024 KiB. Color 80x25, EGA/VGA.
+    auto phys_proxy = system->physProxy;
+    uint8_t boot[16] = {};
+    boot[0] = 0;             // cursor x
+    boot[1] = 0;             // cursor y
+    boot[2] = 0x00;          // EXT_MEM_K low, 15360
+    boot[3] = 0x3C;
+    // 0x90004 video page stays 0
+    boot[6] = 0x03;          // mode 3
+    boot[7] = 80;            // columns
+    phys_proxy.writeBlob(0x90000, boot, sizeof(boot));
+    uint16_t root_dev = htole<uint16_t>(0x0301);
+    phys_proxy.writeBlob(0x901FC, &root_dev, sizeof(root_dev));
+
+    uint32_t esp = 0;
+    phys_proxy.readBlob(stack->address(), &esp, sizeof(esp));
+    tc->setReg(int_reg::Rsp, letoh(esp));
+    tc->pcState(entry->address());
+
+    const std::string count = linux011Count();
+    if (count == "schedule") {
+        auto schedule = kernelSymtab.find("_schedule");
+        fatal_if(schedule == kernelSymtab.end(), "no _schedule symbol.");
+        const Addr schedulePc = schedule->address();
+        const uint8_t ljmpPat[] = {0xff, 0x2c, 0x24};
+        const Addr ljmpPc = findKernelBytes(schedulePc, 0x100, ljmpPat, 3);
+        fatal_if(ljmpPc == 0, "no ljmp *(%esp) in _schedule.");
+        const uint8_t retPat[] = {0xc3};
+        const Addr retPc = findKernelBytes(ljmpPc, 0x20, retPat, 1);
+        fatal_if(retPc == 0, "no ret after the ljmp in _schedule.");
+        scheduleEntryPcEvent = new I386ScheduleEntry(tc, schedulePc, this);
+        scheduleLjmpPcEvent = new I386ScheduleLjmp(tc, ljmpPc, this);
+        scheduleRetPcEvent = new I386ScheduleRet(tc, retPc, this);
+        inform("32-bit protected mode at startup_32=%#x. "
+               "Counting _schedule at %#x (ljmp %#x, ret %#x).\n",
+               entry->address(), schedulePc, ljmpPc, retPc);
+        return;
+    }
+    if (count == "copy_page") {
+        auto unWp = kernelSymtab.find("_un_wp_page");
+        fatal_if(unWp == kernelSymtab.end(), "no _un_wp_page symbol.");
+        const uint8_t movsPat[] = {0xf3, 0xa5};
+        copyPagePc = findKernelBytes(unWp->address(), 0x120, movsPat, 2);
+        fatal_if(copyPagePc == 0, "no rep movsl in _un_wp_page.");
+        copyPageEntryPcEvent = new I386CopyPageEntry(tc, copyPagePc, this);
+        inform("32-bit protected mode at startup_32=%#x. "
+               "Counting copy_page rep movsl at %#x.\n",
+               entry->address(), copyPagePc);
+        return;
+    }
+    if (count == "range") {
+        const Addr from = linux011HexArg(commandLine, "gem5_from=");
+        const Addr to = linux011HexArg(commandLine, "gem5_to=");
+        fatal_if(from == 0 || to == 0,
+                 "a range address is zero.");
+        fatal_if(from == to,
+                 "range start and end are the same address %#x.", from);
+        rangeEntryPcEvent = new I386RangeEntry(tc, from, to, this);
+        inform("32-bit protected mode at startup_32=%#x. "
+               "Counting from %#x until %#x.\n",
+               entry->address(), from, to);
+        return;
+    }
