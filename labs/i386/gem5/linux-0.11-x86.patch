+#ifndef __CPU_O3_LINUX011_WINDOW_HH__
+#define __CPU_O3_LINUX011_WINDOW_HH__
+
+namespace gem5
+{
+namespace o3
+{
+
+// The Linux 0.11 measurement window ends at a PC event, which runs
+// from inside commit. Stop that commit loop so the next instruction
+// is not counted.
+void linux011StopCommit();
+bool linux011CommitStopped();
+
+} // namespace o3
+} // namespace gem5
+
