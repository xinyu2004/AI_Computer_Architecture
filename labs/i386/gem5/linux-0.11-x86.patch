+Addr
+FsWorkload::findKernelBytes(Addr start, Addr len,
+        const uint8_t *pat, size_t n) const
+{
+    std::vector<uint8_t> buf(len);
+    system->physProxy.readBlob(start, buf.data(), buf.size());
+    for (size_t i = 0; i + n <= buf.size(); ++i) {
+        if (std::memcmp(buf.data() + i, pat, n) == 0)
+            return start + i;
+    }
+    return 0;
+}
