+void
+FsWorkload::onTimerInterruptEntry(ThreadContext *tc)
+{
+    if (timerExitPcEvent != nullptr)
+        return;
+
+    // The PC event runs when the PC becomes _timer_interrupt, before
+    // `push %ds`. The frame built by the interrupt microcode is
+    // EIP, CS, EFLAGS, so the return offset is at ESP.
+    const Addr esp = tc->getReg(int_reg::Rsp);
+    uint32_t ret_eip = 0;
+    TranslatingPortProxy proxy(tc);
+    proxy.readBlob(esp, &ret_eip, sizeof(ret_eip));
+    ret_eip = letoh(ret_eip);
+
+    statistics::reset();
+    linux011TraceWindow(true);
+    timerExitPcEvent = new I386TimerExit(tc, ret_eip);
+    inform("timer interrupt entered, counters restarted, "
+           "return EIP=%#x.\n", ret_eip);
+}
+
+I386TimerEntry::I386TimerEntry(PCEventScope *q, Addr pc, FsWorkload *workload)
+    : PCEvent(q, "timer_interrupt entered", pc), workload(workload)
+{}
+
+void
+I386TimerEntry::process(ThreadContext *tc)
+{
+    workload->onTimerInterruptEntry(tc);
+}
