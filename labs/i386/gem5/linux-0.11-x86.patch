+std::string
+FsWorkload::linux011Count() const
+{
+    const std::string key = "gem5_count=";
+    auto pos = commandLine.find(key);
+    if (pos == std::string::npos)
+        return "timer";
+    std::string count = commandLine.substr(pos + key.size());
+    auto end = count.find(' ');
+    if (end != std::string::npos)
+        count.resize(end);
+    return count;
+}
