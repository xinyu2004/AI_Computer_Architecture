+    st t8, ss, [1, t0, t6], 20, dataSize=4, addressSize=4, atCPL0=True
+    br rom_local_label("legacyModeInterrupt_privRsp")
+legacyModeInterrupt_privNoErr:
+    subi t6, t6, 20, dataSize=4
+    st t7, ss, [1, t0, t6], 0, dataSize=4, addressSize=4, atCPL0=True
+    st t10, ss, [1, t0, t6], 4, dataSize=4, addressSize=4, atCPL0=True
+    st t2, ss, [1, t0, t6], 8, dataSize=4, addressSize=4, atCPL0=True
+    st t12, ss, [1, t0, t6], 12, dataSize=4, addressSize=4, atCPL0=True
+    st t8, ss, [1, t0, t6], 16, dataSize=4, addressSize=4, atCPL0=True
+legacyModeInterrupt_privRsp:
+    mov rsp, rsp, t6, dataSize=4
+    br rom_local_label("legacyModeInterrupt_enter")
+
+legacyModeInterrupt_same:
+    limm t0, 0, dataSize=8
+    rdsel t10, cs, dataSize=2
+    rflags t2, dataSize=8
+    mov t6, t6, rsp, dataSize=4
+    andi t1, t13, 4, flags=(EZF,), dataSize=8
+    br rom_local_label("legacyModeInterrupt_sameNoErr"), flags=(CEZF,)
+    subi t6, t6, 16, dataSize=4
+    st t15, ss, [1, t0, t6], 0, dataSize=4, addressSize=4
+    st t7, ss, [1, t0, t6], 4, dataSize=4, addressSize=4
+    st t10, ss, [1, t0, t6], 8, dataSize=4, addressSize=4
+    st t2, ss, [1, t0, t6], 12, dataSize=4, addressSize=4
+    br rom_local_label("legacyModeInterrupt_setRsp")
+legacyModeInterrupt_sameNoErr:
+    subi t6, t6, 12, dataSize=4
+    st t7, ss, [1, t0, t6], 0, dataSize=4, addressSize=4
+    st t10, ss, [1, t0, t6], 4, dataSize=4, addressSize=4
+    st t2, ss, [1, t0, t6], 8, dataSize=4, addressSize=4
+legacyModeInterrupt_setRsp:
+    mov rsp, rsp, t6, dataSize=4
+
+legacyModeInterrupt_enter:
+    wrdl cs, t3, t5, dataSize=8
+    wrsel cs, t5, dataSize=2
+    wrip t0, t9, dataSize=8
