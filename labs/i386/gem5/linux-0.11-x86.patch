+    val = (completeTick == -1) ? 0 : fetch + completeTick;
+    DPRINTFR(O3PipeView, "O3PipeView:complete:%llu\n", val);
+    val = (commitTick == -1) ? 0 : fetch + commitTick;
+
+    Tick valS = (storeTick == -1) ? 0 : fetch + storeTick;
