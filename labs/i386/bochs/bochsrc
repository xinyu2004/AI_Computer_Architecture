# Linux 0.11, step 3. labs/i386/bochs/launch.sh starts Bochs with this file.
# The script appends the display_library line and runs from the repository root.

romimage: file=/usr/share/bochs/BIOS-bochs-legacy, options=fastboot
vgaromimage: file=/usr/share/vgabios/vgabios.bin
megs: 16

# pentium is the oldest named CPU in this Bochs package. The kernel uses
# 386 instructions. A low ips value makes the floppy delays finish after
# fewer instructions, so the boot reaches the debugger promptly.
cpu: model=pentium, count=1, ips=1000000, reset_on_triple_fault=1
clock: sync=none, time0=local

pci: enabled=0
mouse: enabled=0
sound: waveoutdrv=dummy, waveindrv=dummy

boot: floppy
floppya: 1_44=src/linux-0.11/Image, status=inserted

ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata1: enabled=0
ata0-master: type=disk, mode=flat, path=rootfs/hdc-0.11.img, cylinders=410, heads=16, spt=38, translation=none

magic_break: enabled=0
panic: action=fatal
error: action=report
info: action=report
debug: action=ignore
log: labs/i386/bochs/bochs.log
